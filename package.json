{
  "name": "bearing",
  "version": "0.1.0",
  "private": true,
  "description": "Bearing: collision avoidance for coding agents. Agents declare a course, Bearing checks it against all traffic, and steers instead of stopping. Built on Cloudflare Workers + Artifacts.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:offline": "CLOUDFLARE_ENV=offline vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "types": "wrangler types src/worker/env.generated.d.ts --include-runtime false",
    "agent:external": "node scripts/external-agent.mjs",
    "agent:hook": "node scripts/hook-demo.mjs",
    "demo:build": "node demo/build.mjs",
    "e2e:scenario": "node scripts/e2e-scenario.mjs",
    "e2e:guard": "node scripts/e2e-guard.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "acorn": "8.19.0",
    "agents": "0.27.0",
    "d3-hierarchy": "3.1.2",
    "diff": "9.0.0",
    "hono": "4.13.13",
    "isomorphic-git": "1.43.2",
    "node-diff3": "3.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/workers-types": "5.20261008.1",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  }
}
