{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitring",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/preview/*", "/ws/*", "/hooks/*", "/auth/*", "/setup", "/setup/*", "/privacy", "/terms"]
  },
  // Real services everywhere: Cloudflare Artifacts (git) and Workers AI (Clef + agent models).
  // Local development (`npm run dev`) uses the remote Artifacts and AI bindings of your account.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "gitring", "remote": true }],
  "ai": { "binding": "AI", "remote": true },
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      { "name": "HARBOR", "class_name": "HarborMaster" },
      { "name": "VESSEL", "class_name": "Vessel" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "DRYDOCK", "class_name": "Drydock" }
    ]
  },
  // Check containers: each Drydock starts the Cloudflare-managed Node.js 24 image (cloudflare/debian-trixie)
  // and picks its size at start, so there is no image to build.
  "containers": [{ "class_name": "Drydock", "scheduling_policy": "durable_object" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HarborMaster"] },
    { "tag": "v2", "new_sqlite_classes": ["Vessel", "Sector", "LocalArtifacts"] },
    // The local git emulator is gone from the product (it lives on as a test double).
    { "tag": "v3", "deleted_classes": ["LocalArtifacts"] },
    // People, sessions, API keys, projects, roles and sealed provider credentials.
    { "tag": "v4", "new_sqlite_classes": ["Directory"] },
    // Check containers (one per attempt).
    { "tag": "v5", "new_sqlite_classes": ["Drydock"] },
    // The scale simulation left the product.
    { "tag": "v6", "deleted_classes": ["Sector"] }
  ],
  "vars": {
    "ARTIFACTS_NAMESPACE": "gitring",
    "AGENT_MODELS": "@cf/moonshotai/kimi-k2.7-code,@cf/openai/gpt-oss-120b,@cf/qwen/qwen3.8-27b",
    "AI_AGENTS_PER_HOUR": "40",
    "AI_AGENTS_PER_USER_HOUR": "12",
    "CHECK_RUNS_PER_HOUR": "2000",
    "CHECK_RUNS_PER_OWNER_HOUR": "240"
  },
  // Imports read many git objects from Artifacts in one request, and index large repositories.
  "limits": { "subrequests": 100000, "cpu_ms": 300000 },
  "observability": { "enabled": true }
}
