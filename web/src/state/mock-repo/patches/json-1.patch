### +tests/book-endpoint.test.js
import { test, expect } from "../harness/test.js";
import worker from "../src/index.js";

const get = (path) => worker.fetch(new Request("https://shop.test" + path));

test("returns one book as JSON", async () => {
  const res = await get("/api/books/tidewater-almanac");
  expect(res.status).toBe(200);
  expect((await res.json()).title).toBe("Tidewater Almanac");
});

test("keeps the price in cents", async () => {
  const book = await (await get("/api/books/estuary-birds")).json();
  expect(book.cents).toBe(2650);
});

test("adds a formatted price", async () => {
  const book = await (await get("/api/books/estuary-birds")).json();
  expect(book.price).toBe("£26.50");
});

test("returns 404 with a JSON error for an unknown id", async () => {
  const res = await get("/api/books/no-such-book");
  expect(res.status).toBe(404);
  expect((await res.json()).error).toBeTruthy();
});
