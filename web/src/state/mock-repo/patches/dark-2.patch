### +tests/dark-mode.test.js
import { test, expect } from "../harness/test.js";
import { css } from "../src/styles.js";
import { renderPage } from "../src/render.js";
import { books } from "../src/products.js";

const html = renderPage(books);

test("adds a dark color scheme", () => {
  expect(css).toMatch(/prefers-color-scheme:\s*dark/);
});

test("keeps the light theme as default", () => {
  expect(css).toMatch(/--paper:\s*#fbfaf7/);
});

test("renders a theme control in the header", () => {
  const header = html.slice(html.indexOf("<header"), html.indexOf("</header>"));
  expect(header).toMatch(/theme/);
});

test("gives the theme control an accessible name", () => {
  expect(html).toMatch(/(aria-pressed|<label[^>]*>[^<]*Theme)/);
});

test("uses color variables for text and paper", () => {
  expect(css).toContain("var(--ink)");
  expect(css).toContain("var(--paper)");
});

test("keeps text contrast at 4.5:1 or more", () => {
  expect(css).toContain("--ink: #ebe6dc");
});
