### +tests/search.test.js
import { test, expect } from "../harness/test.js";
import worker from "../src/index.js";
import { searchBooks } from "../src/products.js";

// The search can live on the shelf (/?q=) or on its own page (/search?q=). Both count.
const page = (path) => worker.fetch(new Request("https://shop.test" + path)).then((r) => r.text());
const both = async (q) => (await page("/" + q)) + (await page("/search" + q));

test("matches a title", () => {
  expect(searchBooks("harbour").map((b) => b.id)).toEqual(["the-quiet-harbour"]);
});

test("matches an author", () => {
  expect(searchBooks("Moreau").length).toBe(1);
});

test("ignores case", () => {
  expect(searchBooks("TIDEWATER").length).toBe(1);
});

test("returns no books for a nonsense query", () => {
  expect(searchBooks("zzzz").length).toBe(0);
});

test("shows a message when nothing matches", async () => {
  expect(await both("?q=zzzz")).toContain("No books match");
});

test("renders a search field with a label", async () => {
  expect(await both("")).toMatch(/<label for="q">/);
});

test("keeps the shelf at /", async () => {
  expect(await page("/")).toContain("Tidewater Almanac");
});

test("shows prices in the results", async () => {
  expect(await both("?q=tide")).toContain("£18.99");
});
