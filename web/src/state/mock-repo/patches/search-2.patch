export function renderSearchPage(query, results, currency = "GBP") {
  const rows = results
    .map((b) => `<li><strong>${escape(b.title)}</strong> · ${escape(b.author)} · ${formatPrice(b.cents, currency)}</li>`)
    .join("\n      ");
  const body = !query
    ? "<p>Type a title or an author.</p>"
    : results.length
      ? `<ul class="results">\n      ${rows}\n    </ul>`
      : "<p>No books match your search. Try a shorter word.</p>";
  return `<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>Search · Saltmarsh Books</title><style>${css}</style></head>
<body>
  ${renderHeader()}
  <main class="prose">
    <h1>Search</h1>
    <form role="search" action="/search" method="get" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <label for="q">Title or author</label>
      <input id="q" name="q" type="search" value="${escape(query)}" autofocus>
      <button type="submit">Search</button>
    </form>
    ${body}
  </main>
  ${renderFooter()}
</body>
</html>`;
}

