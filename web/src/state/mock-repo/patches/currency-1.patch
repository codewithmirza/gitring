### +tests/currency.test.js
import { test, expect } from "../harness/test.js";
import worker from "../src/index.js";
import { books, formatPrice } from "../src/products.js";

const page = (path, headers = {}) =>
  worker.fetch(new Request("https://shop.test" + path, { headers })).then((r) => r.text());

test("formats pounds by default", async () => {
  expect(await page("/")).toContain("£18.99");
});

test("formats euros from ?currency=EUR", async () => {
  expect(await page("/?currency=EUR")).toContain("€22.22");
});

test("formats dollars from Accept-Language en-US", async () => {
  expect(await page("/", { "accept-language": "en-US,en;q=0.8" })).toContain("US$24.12");
});

test("keeps prices in integer cents", () => {
  for (const b of books) expect(Number.isInteger(b.cents)).toBe(true);
});

test("falls back to pounds for an unknown currency", () => {
  expect(formatPrice(1450, "XYZ")).toBe("£14.50");
});
