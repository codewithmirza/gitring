// ?currency=EUR wins. Then the Accept-Language region. Then GBP.
function readerCurrency(request, url) {
  const asked = (url.searchParams.get("currency") || "").toUpperCase();
  if (RATES[asked]) return asked;
  const lang = request.headers.get("accept-language") || "";
  if (/^en-US\b/i.test(lang)) return "USD";
  if (/^(de|fr|es|it|nl|pt)\b/i.test(lang)) return "EUR";
  return "GBP";
}

