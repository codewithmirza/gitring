### +tests/staff-picks.test.js
import { test, expect } from "../harness/test.js";
import { renderPage, renderBookCard } from "../src/render.js";
import { books } from "../src/products.js";

const picks = books.filter((b) => b.staffPick);

test("marks three books as staff picks", () => {
  expect(picks.length).toBe(3);
});

test("shows a badge on a staff pick", () => {
  expect(renderBookCard(picks[0])).toContain("Staff pick");
});

test("shows the staff note under the title", () => {
  const html = renderBookCard(picks[0]);
  expect(html.indexOf("staff-note") > html.indexOf("book-title")).toBe(true);
});

test("shows no badge on other books", () => {
  const other = books.find((b) => !b.staffPick);
  expect(renderBookCard(other)).not.toContain("Staff pick");
});

test("keeps one card per book", () => {
  expect(renderPage(books).split("<article").length - 1).toBe(books.length);
});
