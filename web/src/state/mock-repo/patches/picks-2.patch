===
export function renderBookCard(book, currency = "GBP") {
  const pick = book.staffPick ? `<p class="badge">Staff pick</p>` : "";
  const note = book.staffPick ? `<p class="staff-note">${escape(book.staffPick)}</p>` : "";
  return `<article class="book"${book.staffPick ? ' data-pick="staff"' : ""}>
      ${pick}
      <h2 class="book-title">${escape(book.title)}</h2>
      ${note}
>>>
