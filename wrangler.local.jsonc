{
  // Local run with no Cloudflare account: `npm run dev:local`.
  // Every binding runs on your computer. A test version of Artifacts (real git) takes the place of
  // Cloudflare Artifacts (see local/worker.ts). There is no Workers AI binding and no container.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitring-local",
  "main": "local/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/preview/*", "/ws/*", "/hooks/*", "/auth/*", "/oauth/*", "/.well-known/*", "/setup", "/setup/*", "/privacy", "/terms"]
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_TOKEN", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_MCP", "namespace_id": "4103", "simple": { "limit": 3000, "period": 60 } },
    { "name": "RL_API", "namespace_id": "4104", "simple": { "limit": 1200, "period": 60 } },
    { "name": "RL_CRED", "namespace_id": "4105", "simple": { "limit": 6000, "period": 60 } },
    { "name": "RL_HOOK", "namespace_id": "4106", "simple": { "limit": 1200, "period": 60 } },
    { "name": "RL_PREVIEW", "namespace_id": "4107", "simple": { "limit": 600, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HARBOR", "class_name": "HarborMaster" },
      { "name": "VESSEL", "class_name": "Vessel" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "DRYDOCK", "class_name": "Drydock" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HarborMaster", "Vessel", "Directory", "Drydock"] }],
  "vars": {
    "ARTIFACTS_NAMESPACE": "gitring",
    // local/start.mjs sets the keys and the address of the test version of Artifacts.
    "LOCAL_ARTIFACTS_URL": "http://127.0.0.1:8792",
    // The same agent models as the deployment (a local run has no Workers AI binding, so agents do not start).
    "AGENT_MODELS": "@cf/zai-org/glm-5.3-flash,@cf/zai-org/glm-5.3",
    "CHECK_RUNS_PER_HOUR": "2000",
    "CHECK_RUNS_PER_OWNER_HOUR": "240"
  }
}
