# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars. Use other values than production.
# Seals the sign-in credentials (GitHub App, Google client). Make one: openssl rand -base64 32
GITRING_SECRET=
# Opens /setup before an owner signs in. Make one: openssl rand -hex 16
GITRING_SETUP_TOKEN=
# Owners of this gitring: they open /setup and act on every project.
GITRING_OWNERS=github:your-login,google:you@example.com
# Optional operator key for scripts and MCP clients (acts as an owner on every project). Make one: openssl rand -hex 24
GITRING_KEY=
# Optional push notifications for the inbox (Web Push). Make the keys: npx web-push generate-vapid-keys
# Leave them empty to turn push off: the app then hides the switch.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional contact address on the privacy and terms pages.
GITRING_CONTACT=
# Optional: a plain GitHub repository webhook (no GitHub App). Any long random value.
GITHUB_WEBHOOK_SECRET=
# Optional: the Slack slash command. The signing secret of your Slack app.
SLACK_SIGNING_SECRET=
# The values below are not secrets. They are `vars` in wrangler.jsonc. Set them there, or here for `npm run dev`.
# The Artifacts namespace that holds all repositories. Make it the same as `artifacts[0].namespace`.
# ARTIFACTS_NAMESPACE=gitring
# The Workers AI models of the built-in agents, in order (comma separated).
# AGENT_MODELS=@cf/zai-org/glm-5.3-flash,@cf/zai-org/glm-5.3
# Hourly limits that protect your bill: built-in agents, and test containers.
# AI_AGENTS_PER_HOUR=40
# AI_AGENTS_PER_USER_HOUR=12
# CHECK_RUNS_PER_HOUR=2000
# CHECK_RUNS_PER_OWNER_HOUR=240
